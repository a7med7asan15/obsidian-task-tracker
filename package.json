{
  "name": "obsidian-task-tracker",
  "version": "0.2.0",
  "description": "Jira-style task tracker for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^20.12.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^1.6.0"
  }
}
